[Unit]
Description=AIOps Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际部署路径修改
WorkingDirectory=/opt/aiops-agent
ExecStart=/usr/bin/python3 /opt/aiops-agent/agent.py -c /opt/aiops-agent/config.yaml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
