# AIOps平台后端配置 - 部署时请修改后保存为 .env 放在 backend/ 目录
# 注意：文件名必须是 .env（没有前缀）

# ===== 数据库 =====
# 默认SQLite（无需额外安装，数据存aiops.db文件）
DATABASE_URL=sqlite+aiosqlite:///./aiops.db
# 如用MySQL（需先 pip 安装 aiomysql，并建好库）:
# DATABASE_URL=mysql+aiomysql://aiops:你的密码@127.0.0.1:3306/aiops

# ===== 认证密钥（务必改成随机字符串）=====
SECRET_KEY=please-change-this-to-a-random-secret-key

# Agent上报令牌（所有Agent的config.yaml中需与此一致）
AGENT_TOKEN=aiops-agent-shared-token

# ===== 千问大模型（OpenAI兼容API）=====
# 若用vLLM: http://模型服务器IP:8000/v1
# 若用Ollama: http://模型服务器IP:11434/v1
# 暂未部署可先留默认，AI功能会提示连接失败但不影响其他功能
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen2.5

# ===== VMware（也可在Web界面配置）=====
VMWARE_HOST=
VMWARE_USER=
VMWARE_PASSWORD=
